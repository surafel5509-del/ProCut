<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="procut.db" />
        <exclude
            domain="file"
            path="media" />
        <exclude
            domain="file"
            path="exports" />
        <exclude
            domain="file"
            path="thumbnails" />
        <exclude
            domain="file"
            path="waveforms" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="procut.db" />
    </device-transfer>
</data-extraction-rules>
