<?xml version="1.0" encoding="utf-8"?>
<!-- Back up project metadata, but not imported/copied media (it can be very large). -->
<full-backup-content>
    <include
        domain="database"
        path="procut.db" />
    <exclude
        domain="file"
        path="media" />
    <exclude
        domain="file"
        path="exports" />
    <exclude
        domain="file"
        path="thumbnails" />
    <exclude
        domain="file"
        path="waveforms" />
</full-backup-content>
